# Choose the LangChain provider: openai or gemini.
LLM_PROVIDER=gemini

# Model name for the selected provider.
LLM_MODEL=gemini-3.1-flash-lite

# OpenAI-only reasoning level. Gemini does not receive this option.
LLM_REASONING_EFFORT=medium

# Set only the key for the selected provider. Never commit either key.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Static bearer token required for POST /api/query. Use a long random value locally.
API_AUTH_TOKEN=

# Read-only Expenses workbook ledger configuration. credentials.json and
# token.json are ignored; run `npm run google-auth` for one-time OAuth setup.
# The OAuth callback is fixed in the application: http://localhost:3000/oauth2callback.
# Desktop OAuth clients need no .env setting or Web-client redirect-uri allowlist.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_MONTH_TABS=April,May,June,July,August,September,October,November,December,January,February,March
GOOGLE_SHEETS_LEDGER_RANGE=A9:G
